<?xml version='1.0' encoding='utf-8'?>
<widget id="com.astroblitz.game" version="1.0.0" xmlns="http://www.w3.org/ns/widgets" xmlns:cdv="http://cordova.apache.org/ns/1.0">
    <name>Astro Bitz</name>
    <description>Fast-paced space shooter game. Battle waves of enemies and bosses!</description>
    <author email="you@example.com" href="https://yourgame.com">
        Your Name
    </author>
    <content src="index.html" />

    <!-- Platform preferences -->
    <preference name="Orientation" value="portrait" />
    <preference name="Fullscreen" value="true" />
    <preference name="StatusBarOverlaysWebView" value="false" />
    <preference name="StatusBarBackgroundColor" value="#1a1a2e" />
    <preference name="BackgroundColor" value="#1a1a2e" />

    <!-- Disable web view scaling -->
    <preference name="DisallowOverscroll" value="true" />
    <preference name="AutoHideSplashScreen" value="true" />
    <preference name="SplashScreenDelay" value="3000" />

    <!-- iOS specific -->
    <platform name="ios">
        <preference name="WKWebViewOnly" value="true" />
        <preference name="CordovaWebViewEngine" value="CDVWKWebView" />
    </platform>

    <!-- Android specific -->
    <platform name="android">
        <preference name="android-minSdkVersion" value="24" />
        <preference name="android-targetSdkVersion" value="35" />
    </platform>

    <allow-intent href="http://*/*" />
    <allow-intent href="https://*/*" />
</widget>
